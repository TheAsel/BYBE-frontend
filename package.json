{
  "name": "bybe-frontend",
  "version": "4.1.1",
  "description": "Beyond Your Bestiary Explorer (BYBE) is a one-stop shop for the most useful tools for Pathfinder 2e and Starfinder 2e GMs",
  "productName": "BYBE - Pathfinder 2e and Starfinder 2e GM Tools",
  "author": "TheAsel",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "dev": "quasar dev",
    "build": "quasar build",
    "start": "./node_modules/@quasar/cli/bin/quasar.js serve dist/spa --history --hostname localhost"
  },
  "dependencies": {
    "@quasar/extras": "^1.18.0",
    "@unhead/vue": "^3.1.0",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "quasar": "^2.19.3",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "vue3-tour": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^2.6.0",
    "@quasar/cli": "^4.0.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-vue": "^10.9.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.6.0",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite-plugin-checker": "^0.13.0",
    "vue-tsc": "^3.2.7"
  },
  "engines": {
    "node": ">= 22",
    "npm": ">= 10"
  }
}

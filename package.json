{
  "name": "bybe-frontend",
  "version": "4.1.0",
  "description": "Beyond Your Bestiary Explorer (BYBE) is a one-stop shop for the most useful tools for Pathfinder 2e and Starfinder 2e GMs",
  "productName": "BYBE - Pathfinder 2e and Starfinder 2e GM Tools",
  "author": "TheAsel",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "dev": "quasar dev",
    "build": "quasar build",
    "start": "./node_modules/@quasar/cli/bin/quasar.js serve dist/spa --history --hostname localhost"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "@unhead/vue": "^2.1.10",
    "lodash-es": "^4.17.23",
    "pinia": "^3.0.4",
    "quasar": "^2.18.6",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "vue3-tour": "1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^2.4.1",
    "@quasar/cli": "2.5.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.3.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "dotenv": "17.3.1",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-import": "2.32.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "5.9.3",
    "vite-plugin-checker": "^0.12.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": ">= 22",
    "npm": ">= 10"
  }
}

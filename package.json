{
  "name": "bybe-frontend",
  "version": "4.0.0",
  "description": "Beyond Your Bestiary Explorer (BYBE) is a one-stop shop for the most useful tools for Pathfinder Second Edition GMs",
  "productName": "BYBE - Pathfinder 2e GM Tools",
  "author": "TheAsel",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint --fix -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "dev": "quasar dev",
    "build": "quasar build",
    "start": "./node_modules/@quasar/cli/bin/quasar.js serve dist/spa --history --hostname localhost"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "@unhead/vue": "^2.0.17",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.3",
    "quasar": "^2.18.5",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue3-tour": "1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@quasar/app-vite": "^2.4.0",
    "@quasar/cli": "2.5.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.5.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "17.2.2",
    "eslint": "^9.36.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-vue": "^10.5.0",
    "eslint-plugin-import": "2.32.0",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.2",
    "vite-plugin-checker": "^0.10.3",
    "vue-tsc": "^3.0.8"
  },
  "engines": {
    "node": ">= 22",
    "npm": ">= 10"
  }
}

{
  "name": "bybe-frontend",
  "version": "5.0.3",
  "private": true,
  "description": "Beyond Your Bestiary Explorer (BYBE) is a one-stop shop for the most useful tools for Pathfinder 2e and Starfinder 2e GMs",
  "author": "TheAsel <a.osele@proton.me>",
  "type": "module",
  "scripts": {
    "postinstall": "quasar prepare --silent",
    "lint": "oxfmt && oxlint --type-aware --fix",
    "lint:check": "oxfmt --check && oxlint --type-aware",
    "typecheck": "vue-tsc --noEmit",
    "dev": "quasar dev",
    "build": "quasar build",
    "start": "./node_modules/@quasar/cli/bin/quasar.js serve dist/spa --history --hostname localhost"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@quasar/extras": "^2.0.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@unhead/vue": "^3.2.3",
    "lodash-es": "^4.18.1",
    "pinia": "^4.0.2",
    "quasar": "^2.23.4",
    "shepherd.js": "^15.2.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-shepherd": "^6.0.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.3.0",
    "@quasar/cli": "^5.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.5.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "BYBE - Pathfinder 2e and Starfinder 2e GM Tools"
}

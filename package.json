{
  "name": "bybe-frontend",
  "version": "5.1.1",
  "private": true,
  "description": "Beyond Your Bestiary Explorer (BYBE) is a one-stop shop for the most useful tools for Pathfinder 2e and Starfinder 2e GMs",
  "author": "TheAsel <a.osele@proton.me>",
  "type": "module",
  "scripts": {
    "postinstall": "quasar prepare --silent",
    "lint": "oxfmt && oxlint --type-aware --fix",
    "lint:check": "oxfmt --check && oxlint --type-aware",
    "typecheck": "vue-tsc --noEmit",
    "dev": "quasar dev",
    "build": "quasar build",
    "start": "./node_modules/@quasar/cli/bin/quasar.js serve dist/spa --history --hostname localhost"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@quasar/extras": "^2.1.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@unhead/vue": "^3.4.3",
    "lodash-es": "^4.18.1",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "shepherd.js": "^15.3.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-shepherd": "^6.0.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.3",
    "@quasar/cli": "^5.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "typescript": "$typescript"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "BYBE - Pathfinder 2e and Starfinder 2e GM Tools"
}
